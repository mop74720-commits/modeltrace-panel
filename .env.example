# Copy to .env on the VPS. Set a strong random panel password before starting.
PANEL_ACCESS_TOKEN=
# Optional exact hostname allowlist, comma separated. Empty permits public hosts.
UPSTREAM_HOSTS=
# Enter upstream URL / model / API Key in the web panel; these defaults are optional.
UPSTREAM_BASE_URL=
UPSTREAM_MODEL=
UPSTREAM_API_KEY=
# Keep 0 for normal public VPS networking.
ALLOW_PRIVATE_UPSTREAM=0
# Optional Fernet key. If empty, a key is created in the persistent config volume.
CONFIG_ENCRYPTION_KEY=
